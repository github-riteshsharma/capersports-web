# ===== API CONFIGURATION =====
REACT_APP_API_URL=http://localhost:5001/api

# ===== APP CONFIGURATION =====
REACT_APP_NAME=CaperSports
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Premium Sports Clothing E-commerce Platform
