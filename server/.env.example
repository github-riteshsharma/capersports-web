# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# ===== DATABASE (MongoDB Atlas or self-hosted) =====
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/capersports?retryWrites=true&w=majority

# ===== JWT AUTHENTICATION =====
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-strong-secret-minimum-32-characters>
JWT_EXPIRE=30d

# ===== CLOUDINARY (Image Storage) =====
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# ===== STRIPE PAYMENT =====
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-stripe-publishable-key>

# ===== EMAIL (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=<your-email@gmail.com>
SMTP_PASSWORD=<your-app-password>

# ===== FRONTEND / CORS =====
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ===== ADMIN SEED SCRIPT (create-admin-user.js) =====
# ADMIN_EMAIL=admin@capersports.com
# ADMIN_PASSWORD=<choose-a-strong-password>
